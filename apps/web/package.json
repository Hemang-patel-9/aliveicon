{
	"name": "aliveicon-web",
	"version": "0.0.0",
	"private": true,
	"description": "Documentation site and icon playground for aliveicon.",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.18.0"
	},
	"scripts": {
		"meta": "node scripts/generate-meta.mjs",
		"dev": "node scripts/run.mjs src next dev",
		"dev:dist": "node scripts/use-dist.mjs && node scripts/run.mjs package next dev",
		"build": "node scripts/run.mjs package next build",
		"build:src": "node scripts/run.mjs src next build",
		"build:dist": "node scripts/use-dist.mjs && node scripts/run.mjs package next build",
		"start": "node scripts/serve.mjs",
		"typecheck": "node scripts/generate-meta.mjs && next typegen && tsc --noEmit",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "playwright test",
		"check": "node scripts/check-config.mjs && npm run typecheck && npm run lint && npm run format:check"
	},
	"dependencies": {
		"aliveicon": "^1.14.0",
		"clsx": "^2.1.1",
		"framer-motion": "^14.10.1",
		"geist": "^1.9.2",
		"next": "^16.4.5",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.0",
		"@tailwindcss/postcss": "^4.3.5",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"eslint": "^9.39.5",
		"eslint-config-next": "^16.4.5",
		"lighthouse": "^13.6.0",
		"prettier": "^3.9.10",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3"
	},
	"overrides": {
		"@typescript-eslint/typescript-estree": {
			"minimatch": "^11.0.1"
		}
	}
}
