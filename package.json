{
  "name": "aliveicon",
  "version": "1.14.0",
  "description": "1400+ animated React icons built on Lucide shapes and Framer Motion. Play on hover, click, mount, loop or via ref. Tree-shakeable, fully typed, Next.js ready.",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json",
    "./*": "./dist/*"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "generate": "node scripts/generate-index.mjs",
    "lint:icons": "node scripts/lint-icons.mjs",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node scripts/smoke-test.mjs",
    "test:unit": "node scripts/unit-test.mjs",
    "dev": "node scripts/web.mjs dev",
    "web": "node scripts/web.mjs",
    "check": "node scripts/generate-index.mjs --check && npm run lint:icons && npm run format:check && npm run typecheck && npm run test:unit",
    "prepublishOnly": "npm run check && npm run build && npm test",
    "format": "prettier --write src test scripts rollup.config.js vitest.config.mjs",
    "format:check": "prettier --check src test scripts rollup.config.js vitest.config.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hemang-patel-9/aliveicon.git"
  },
  "keywords": [
    "react",
    "icons",
    "react-icons",
    "icon",
    "icon-library",
    "animated-icons",
    "animated-svg",
    "svg-icons",
    "svg",
    "line-icons",
    "animation",
    "micro-interactions",
    "hover-animation",
    "framer-motion",
    "motion",
    "lucide",
    "lucide-icons",
    "nextjs",
    "react-components",
    "typescript"
  ],
  "author": "Hemang Baldha",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Hemang-patel-9/aliveicon/issues"
  },
  "homepage": "https://github.com/Hemang-patel-9/aliveicon#readme",
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.0"
  },
  "peerDependencies": {
    "framer-motion": ">=10.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.21",
    "framer-motion": "^12.11.3",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rollup": "^2.79.2",
    "rollup-plugin-typescript2": "^0.36.0",
    "typescript": "^5.8.3",
    "vitest": "^5.1.0"
  }
}
